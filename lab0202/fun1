fun getSeason(month: Int): String {
	val result = when(month) {
		12,1,2 -> "Зима"
		3, 4, 5 -> "Весна"
		in 6..8 -> "Лето"
		in 9..11 -> "Осень"
		else -> "incorrect"
	}
	return result
}
//1.3
fun factorial(n: Int): Long {
	var c = 1
	if (n >= 0) {
		for (tailrec in 1..n){
			c = tailrec * c
		}
	}
	else{
		return -1
	}
	return c
}
